# Node
node_modules/
dist/
.vite/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Editors and operating systems
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# Build and signing
*.exe
*.msi
*.pdb
*.ilk
*.pfx
.env
.env.local

# Acceptance screenshots are run output, not source files.
qa/shots/

# QA debris: screenshots and one-off agent scripts. It was accidentally committed
# twice through git add -A, so keep it excluded by pattern rather than by discipline.
/artifacts/
/scratch/
/*.png
/qa/*.log
/qa/*.out
/qa/*.reg
/qa/shots/
# Acceptance run logs and their summary are machine output, not source files.
/qa/*.jsonl
/qa/acceptance-summary.json

# Formatting-check cache: rebuilt automatically and not needed in the repository.
/.impeccable/hook.cache.json

# Python leaves these next to the helper scripts.
__pycache__/
*.pyc
