			// Closing is a durability boundary, not an autosave tick: flush every
			// named dirty tab regardless of the user's interval/format settings.
			(await $.track_reactivity_loss(autosaveController.flushAll(true)))();
		}

		const dirtyTabs = getTabsRequiringPrompt();

		if ($.strict_equals(dirtyTabs.length, 0)) {
			(await $.track_reactivity_loss(respondToNativeClose(true)))();

			return;
		}

		$.set(closeRequestSource, "native");
		$.set(pendingCloseTabId, null);
		$.set(closePromptTabs, dirtyTabs, true);
		$.set(closePromptOpen, true);
	}

	async function closeWindowAfterDecision() {
		$.set(closeAfterDecision, true);

		try {
			(await $.track_reactivity_loss(getCurrentWindow().close()))();
		} catch(error) {
			$.set(closeAfterDecision, false);
			reportError(error);
		}
	}

	async function requestClose() {
		if (autosaveController) {
			(await $.track_reactivity_loss(autosaveController.flushAll(true)))();
		}

		const dirtyTabs = getTabsRequiringPrompt();

		if ($.strict_equals(dirtyTabs.length, 0)) {
			(await $.track_reactivity_loss(closeWindowAfterDecision()))();

			return;
		}

		$.set(closeRequestSource, "menu");
		$.set(pendingCloseTabId, null);
		$.set(closePromptTabs, dirtyTabs, true);
		$.set(closePromptOpen, true);
	}

	function handleOpenNewTab() {
		if ($.get(editorView)) {
			tabEditorStates.set(workspace.activeId, $.get(editorView).state);
		}

		const newId = openTab();

		$.set(startScreenDismissed, false);

		if ($.get(editorView)) {
			const tab = activeTab();

			const newState = createEditorState($.get(editorView), {
				doc: tab.document.text,
				format: tab.document.format,
				path: tab.document.path
			});

			tabEditorStates.set(newId, newState);
			setEditorState($.get(editorView), newState);
			$.get(editorView).focus();
		} else {
			rebuildEditor(true);
		}
	}

	function handleSelectTab(id) {
		if ($.strict_equals(id, workspace.activeId)) return;

		if ($.get(editorView)) {
			tabEditorStates.set(workspace.activeId, $.get(editorView).state);
		}

		activateTab(id);

		const tab = activeTab();

		$.set(startScreenDismissed, $.strict_equals(tab.document.path, null, false) || tab.document.text.length > 0, true);

		if ($.get(editorView)) {
			let nextState = tabEditorStates.get(id);

			if (!nextState) {
				nextState = createEditorState($.get(editorView), {
					doc: tab.document.text,
					format: tab.document.format,
					path: tab.document.path
				});

				tabEditorStates.set(id, nextState);
			}

			setEditorState($.get(editorView), nextState);
			$.get(editorView).focus();
		}
	}

	async function handleCloseTab(id) {
		const tab = workspace.tabs.find((t) => $.strict_equals(t.id, id));

		if (!tab) return;

		if (workspace.tabs.length <= 1) {
			(await $.track_reactivity_loss(requestClose()))();

			return;
		}

		if ($.strict_equals(tab.document.path, null, false) && tab.document.dirty && tab.document.format.autosave && !tab.document.readonly && $.strict_equals(settingsState.settings?.files?.autosave, false, false)) {
			(await $.track_reactivity_loss(autosaveController?.flush(true, id)))();
		}

		if (isTabDirty(tab)) {
			handleSelectTab(id);
			$.set(pendingCloseTabId, id, true);
			$.set(closePromptTabs, [tab], true);
			$.set(closeRequestSource, "tab");
			$.set(closePromptOpen, true);

			return;
		}

		tabEditorStates.delete(id);

		const wasActive = $.strict_equals(workspace.activeId, id);

		closeTab(id);

		if (wasActive && $.get(editorView)) {
			const nextTab = activeTab();
			let nextState = tabEditorStates.get(nextTab.id);

			if (!nextState) {
				nextState = createEditorState($.get(editorView), {
					doc: nextTab.document.text,
					format: nextTab.document.format,
					path: nextTab.document.path
				});

				tabEditorStates.set(nextTab.id, nextState);
			}

			setEditorState($.get(editorView), nextState);
			$.get(editorView).focus();
		}
	}

	async function handleCloseChoice(choice) {
		const tabToClose = $.get(pendingCloseTabId);

		const tabsToProcess = $.get(closePromptTabs).length > 0
			? [...$.get(closePromptTabs)]
			: tabToClose
				? [
					workspace.tabs.find((t) => $.strict_equals(t.id, tabToClose))
				].filter(Boolean)
				: [];

		const source = $.get(closeRequestSource);

		if ($.strict_equals(choice, "cancel")) {
			$.set(closePromptOpen, false);
			$.set(closeRequestSource, null);
			$.set(pendingCloseTabId, null);
			$.set(closePromptTabs, [], true);

			if ($.strict_equals(source, "native")) (await $.track_reactivity_loss(respondToNativeClose(false)))();

			return;
		}

		if ($.strict_equals(choice, "save")) {
			$.set(closePromptOpen, false);

			for (const tab of tabsToProcess) {
				handleSelectTab(tab.id);
				(await $.track_reactivity_loss(tick()))();

				const saved = $.strict_equals(tab.document.path, null)
					? (await $.track_reactivity_loss(saveDocumentAs()))()
					: (await $.track_reactivity_loss(saveNow()))();

				if (!saved) {
					$.set(closeRequestSource, null);
					$.set(pendingCloseTabId, null);
					$.set(closePromptTabs, [], true);

					if ($.strict_equals(source, "native")) (await $.track_reactivity_loss(respondToNativeClose(false)))();

					return;
				}
			}
		}

		$.set(closePromptOpen, false);
		$.set(closeRequestSource, null);
		$.set(pendingCloseTabId, null);
		$.set(closePromptTabs, [], true);

		if ($.strict_equals(source, "tab") && tabToClose) {
			tabEditorStates.delete(tabToClose);

			const wasActive = $.strict_equals(workspace.activeId, tabToClose);

			closeTab(tabToClose);

			if (wasActive && $.get(editorView)) {
				const nextTab = activeTab();
				let nextState = tabEditorStates.get(nextTab.id);

				if (!nextState) {
					nextState = createEditorState($.get(editorView), {
						doc: nextTab.document.text,
						format: nextTab.document.format,
						path: nextTab.document.path
					});

					tabEditorStates.set(nextTab.id, nextState);
				}

				setEditorState($.get(editorView), nextState);
				$.get(editorView).focus();
			}

			return;
		}

		if ($.strict_equals(source, "native")) {
			(await $.track_reactivity_loss(respondToNativeClose(true)))();
		} else {
			(await $.track_reactivity_loss(closeWindowAfterDecision()))();
		}
	}

	function runEditor(command) {
		if (!$.get(editorView)) return;

		$.get(editorView).focus();
		command($.get(editorView));
	}

	function insertText(text) {
		if (!$.get(editorView) || $.get(isReadOnly)) return;

		$.get(editorView).focus();
		$.get(editorView).dispatch($.get(editorView).state.replaceSelection(text));
	}

	function insertLink() {
		if (!$.get(editorView) || $.get(isReadOnly)) return;

		const range = $.get(editorView).state.selection.main;
		const selected = $.get(editorView).state.sliceDoc(range.from, range.to);

		if (selected) {
			$.get(editorView).dispatch({
				changes: { from: range.from, to: range.to, insert: `[${selected}](url)` },
				selection: {
					anchor: range.from + selected.length + 3,
					head: range.from + selected.length + 6
				}
			});
		} else {
			$.get(editorView).dispatch({
				changes: { from: range.from, insert: "[](url)" },
				selection: { anchor: range.from + 1 }
			});
		}
	}

	async function promptInsertImage() {
		if (!$.get(editorView) || $.get(isReadOnly)) return;

		try {
			const selected = (await $.track_reactivity_loss(openFileDialog({
				title: t("image.pickerTitle"),
				multiple: true,
				filters: [
					{
						name: t("image.filterLabel"),
						extensions: [...ACCEPTED_IMAGE_EXTENSIONS]
					}
				]
			})))();

			if (!selected) return;

			const paths = Array.isArray(selected) ? selected : [selected];

			if ($.strict_equals(paths.length, 0)) return;

			(await $.track_reactivity_loss(insertImage($.get(editorView), paths, {
				docPath: documentState.path,
				onNotice: (msg, sev) => {
					$.set(attachmentNotice, { message: msg, severity: sev }, true);
				}
			})))();
		} catch(error) {
			$.set(attachmentNotice, { message: mapAttachmentError(error), severity: "error" }, true);
		}
	}

	function applyList() {
		if (!$.get(editorView) || $.get(isReadOnly)) return;

		const view = $.get(editorView);
		const range = view.state.selection.main;
		const first = view.state.doc.lineAt(range.from).number;
		const last = view.state.doc.lineAt(range.to).number;
		const changes = [];

		for (let number = first; number <= last; number += 1) {
			const line = view.state.doc.line(number);

			if (!(/^\s*(?:[-+*]|\d+[.)])\s+/u).test(line.text)) changes.push({ from: line.from, to: line.from, insert: "- " });
		}

		if (changes.length > 0) view.dispatch({ changes });
	}

	function clipboard(action) {
		if (!$.get(editorView)) return;

		$.get(editorView).focus();

		if ($.strict_equals(action, "paste")) {
			void navigator.clipboard?.readText().then((text) => {
				if (text) $.get(editorView)?.dispatch($.get(editorView).state.replaceSelection(text));
			}).catch(() => undefined);

			return;
		}

		try {
			document.execCommand(action);
		} catch {
			// Clipboard permissions are controlled by WebView2.
		}
	}

	function copyText(text) {
		if (!text) return;

		void navigator.clipboard?.writeText(text).catch(() => undefined);
