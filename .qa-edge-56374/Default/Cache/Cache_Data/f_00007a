	function handleDragOver(event) {
		event.preventDefault();

		if (event.dataTransfer) event.dataTransfer.dropEffect = "copy";

		$.set(isDraggingOver, true);
	}

	function handleDragLeave(event) {
		if (!event.relatedTarget || !event.currentTarget?.contains(event.relatedTarget)) {
			$.set(isDraggingOver, false);
		}
	}

	function handleWindowKeydown(event) {
		if ($.get(closePromptOpen)) {
			if ($.strict_equals(event.key, "Escape")) {
				event.preventDefault();
				void handleCloseChoice("cancel");
			}

			return;
		}

		const modifier = event.ctrlKey || event.metaKey;
		const target = event.target;
		const editorHasEvent = $.strict_equals(typeof Node, "undefined", false) && target instanceof Node && Boolean($.get(editorView)?.contentDOM.contains(target));

		if (modifier && $.strict_equals(event.code, "KeyS") && !editorHasEvent) {
			event.preventDefault();
			void (event.shiftKey ? saveDocumentAs() : saveNow());
		} else if (modifier && event.shiftKey && $.strict_equals(event.code, "KeyI")) {
			event.preventDefault();
			void promptInsertImage();
		} else if (modifier && $.strict_equals(event.code, "Comma")) {
			event.preventDefault();
			void openSettingsWindow();
		} else if (modifier && $.strict_equals(event.code, "KeyT")) {
			event.preventDefault();
			handleOpenNewTab();
		} else if (modifier && $.strict_equals(event.code, "KeyW")) {
			event.preventDefault();

			if (workspace.tabs.length > 1) {
				void handleCloseTab(workspace.activeId);
			} else {
				void requestClose();
			}
		}
	}

	function fileUriToPath(value) {
		if (!value.toLowerCase().startsWith("file://")) return value;

		try {
			const parsed = new URL(value);
			const pathname = decodeURIComponent(parsed.pathname);

			return pathname.replace(/^\/([A-Za-z]:)/u, "$1");
		} catch {
			return value;
		}
	}

	function handleDroppedPaths(paths, position) {
		const normalized = paths.map(fileUriToPath).filter(Boolean);

		if ($.strict_equals(normalized.length, 0)) return;

		const batchKey = normalized.map(pathKey).join("|");
		const now = Date.now();

		if ($.strict_equals(batchKey, lastDropKey) && now - lastDropAt < 750) return;

		lastDropKey = batchKey;
		lastDropAt = now;

		const imagePaths = normalized.filter(isImageExtension);
		const docPaths = normalized.filter((p) => !isImageExtension(p));

		if (imagePaths.length > 0 && $.get(editorView) && !$.get(isReadOnly)) {
			let targetPos;

			if (position && $.strict_equals(typeof window, "undefined", false)) {
				const clientX = position.x / (window.devicePixelRatio || 1);
				const clientY = position.y / (window.devicePixelRatio || 1);
				const coords = $.get(editorView).posAtCoords({ x: clientX, y: clientY });

				if ($.strict_equals(coords, null, false)) {
					targetPos = coords;
				}
			}

			void insertImage($.get(editorView), imagePaths, {
				docPath: documentState.path,
				targetPos,
				onNotice: (msg, sev) => {
					$.set(attachmentNotice, { message: msg, severity: sev }, true);
				}
			});
		}

		if (docPaths.length > 0) {
			// A dropped file opens as a tab in this window: the user already opened the
			// window, and creating another one beside it is not what they expect. Files
			// open in sequence, with each tab taking over the editor state.
			void docPaths.reduce((chain, path) => chain.then(() => openFileInTab(path)), Promise.resolve());
		}
	}

	/** Opens a file as a tab; if it is already open, simply reveals it. */
	async function openFileInTab(path) {
		const key = pathKey(path);
		const existing = workspace.tabs.find((tab) => $.strict_equals(tab.document.path, null, false) && $.strict_equals(pathKey(tab.document.path), key));

		if (existing) {
			handleSelectTab(existing.id);
			$.get(editorView)?.focus();

			return;
		}

		const current = activeTab().document;
		const currentIsEmpty = $.strict_equals(current.path, null) && $.strict_equals(current.text.length, 0) && !current.dirty;

		if (!currentIsEmpty) handleOpenNewTab();

		(await $.track_reactivity_loss(openFile(path)))();
	}

	function handleDrop(event) {
		event.preventDefault();
		$.set(isDraggingOver, false);

		if (event.currentTarget instanceof HTMLElement && event.currentTarget.classList.contains("editor-stage") && event.target?.closest(".start-screen")) return;

		const files = Array.from(event.dataTransfer?.files ?? []);
		const imageFiles = files.filter((file) => isImageExtension(file.name) || file.type.startsWith("image/"));

		if (imageFiles.length > 0 && $.get(editorView) && !$.get(isReadOnly)) {
			const coords = $.get(editorView).posAtCoords({ x: event.clientX, y: event.clientY });
			const targetPos = coords ?? undefined;

			void (async () => {
				const sources = [];

				for (const file of imageFiles) {
					const buffer = (await $.track_reactivity_loss(file.arrayBuffer()))();

					sources.push({
						type: "data",
						data: new Uint8Array(buffer),
						fileName: file.name
					});
				}

				(await $.track_reactivity_loss(insertImage($.get(editorView), sources, {
					docPath: documentState.path,
					targetPos,
					onNotice: (msg, sev) => {
						$.set(attachmentNotice, { message: msg, severity: sev }, true);
					}
				})))();
			})();
		}

		const paths = [];

		for (const file of files) {
			const path = file.path;

			if (path && !isImageExtension(path)) paths.push(path);
		}

		const uriList = event.dataTransfer?.getData("text/uri-list") ?? "";

		if ($.strict_equals(paths.length, 0) && uriList) {
			paths.push(...uriList.split(/\r?\n/u).filter((line) => line && !line.startsWith("#")).map(fileUriToPath).filter((p) => !isImageExtension(p)));
		}

		if (paths.length > 0) {
			handleDroppedPaths(paths);
		}
	}

	$.user_effect(() => {
		const currentTitle = $.get(title);

		if ($.strict_equals(typeof globalThis.document, "undefined", false)) globalThis.document.title = currentTitle;

		try {
			void getCurrentWindow().setTitle(currentTitle).// Show the error instead of swallowing it: a silent catch was what hid
			// the missing permission to change the title and left every window with
			// the same taskbar name.
			catch((error) => console.error(...$.log_if_contains_state('error', "Could not set the window title", error)));
		} catch {
			// Running outside Tauri must not break the editor.
		}
	});

	$.user_effect(() => {
		const text = documentState.text;
		const view = $.get(editorView);

		if (view && $.strict_equals(view.state.doc.toString(), text, false)) replaceEditorText(text);
	});

	$.user_effect(() => {
		// Settings load during module import and arrive from Rust after the editor
		// has started with defaults. From then on, this effect keeps the editor in
		// sync with the settings window: a toggle reconfigures the compartment
		// instead of recreating the editor.
		// Read settings before checking readiness so the effect subscribes to
		// changes after the initial load as well: Svelte tracks what was read.
		const settings = settingsState.settings;

		const ready = settingsState.ready;
		const view = $.get(editorView);

		if (view && ready) applyEditorSettings(view, settings);
	});

	onMount(() => {
		let disposed = false;
