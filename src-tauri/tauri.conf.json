{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MarkNote",
  "version": "1.0.7",
  "identifier": "dev.marknote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MarkNote",
        "width": 900,
        "height": 700,
        "minWidth": 500,
        "minHeight": 400,
        "backgroundColor": "#1e1e1e",
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        {
          "identifier": "main-window-titlebar-dragging",
          "description": "Allow the main window title bar to drag the window.",
          "windows": ["main"],
          "permissions": ["core:window:allow-start-dragging"]
        }
      ],
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
          "ext": ["md", "markdown", "mdown", "mkd", "mdx"],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["txt", "log", "ini", "cfg", "conf", "env", "csv", "tsv"],
        "name": "Plain Text Document",
        "description": "Plain Text Document",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["json"],
        "name": "JSON Document",
        "description": "JSON Document",
        "role": "Editor",
        "mimeType": "application/json"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML Document",
        "description": "YAML Document",
        "role": "Editor",
        "mimeType": "application/yaml"
      },
      {
        "ext": ["toml"],
        "name": "TOML Document",
        "description": "TOML Document",
        "role": "Editor",
        "mimeType": "application/toml"
      },
      {
        "ext": ["xml"],
        "name": "XML Document",
        "description": "XML Document",
        "role": "Editor",
        "mimeType": "application/xml"
      },
      {
        "ext": ["css"],
        "name": "CSS Stylesheet",
        "description": "CSS Stylesheet",
        "role": "Editor",
        "mimeType": "text/css"
      },
      {
        "ext": ["js"],
        "name": "JavaScript Source",
        "description": "JavaScript Source",
        "role": "Editor",
        "mimeType": "text/javascript"
      },
      {
        "ext": ["ts"],
        "name": "TypeScript Source",
        "description": "TypeScript Source",
        "role": "Editor",
        "mimeType": "text/typescript"
      },
      {
        "ext": ["rs"],
        "name": "Rust Source",
        "description": "Rust Source",
        "role": "Editor",
        "mimeType": "text/rust"
      },
      {
        "ext": ["py"],
        "name": "Python Source",
        "description": "Python Source",
        "role": "Editor",
        "mimeType": "text/x-python"
      }
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  },
  "plugins": {}
}
